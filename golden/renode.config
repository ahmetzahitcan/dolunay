; Renode configuration for the golden-model skeleton.
; 
; Pass with `renode --config renode.config`. It exists so the built plugin can
; be enabled for a run without editing the machine-local user configuration
; (~/.config/renode/config on Linux, %APPDATA%\renode on Windows).
; 
; Comments must use ';' here: Renode 1.17's config parser hangs on '#' lines.
; 
; The value is the [Plugin] Name declared in model/Dolunay.cs. The fully
; qualified form "Name:Version:Vendor" is also accepted.

[plugins]
enabled-plugins = Dolunay Golden Model:0.0.0:Dolunay
[general]
terminal = Termsharp
compiler-cache-enabled = False
serialization-mode = Generated
use-synchronous-logging = False
always-log-machine-name = False
collapse-repeated-log-entries = True
log-timestamps-type = Host
log-history-limit = 1000
history-path = /home/azc/.config/renode/history
store-table-bits = 41
[monitor]
consume-exceptions-from-command = True
break-script-on-exception = True
number-format = Hexadecimal
[translation]
min-tb-size = 33554432
max-tb-size = 536870912
