; Renode configuration for the golden-model skeleton.
;
; Enables the built plugin for one run without touching the machine-local user
; configuration (~/.config/renode/config on Linux, %APPDATA%\renode on Windows).
;
; Do NOT pass this file to Renode directly. Renode rewrites the file given to
; --config (merges its defaults, writes machine-local paths such as
; history-path). Copy it under build/ and pass the copy by absolute path:
;
;   cp renode.config build/renode.run.config
;   renode --config "$PWD/build/renode.run.config" ...
;
; Comments must use ';' here: Renode 1.17's config parser hangs on '#' lines.
;
; The value is the [Plugin] Name declared in model/Dolunay.cs. The fully
; qualified form "Name:Version:Vendor" is also accepted.

[plugins]
enabled-plugins = Dolunay Golden Model
