// Dolunay platform description — skeleton.
//
// This is a placeholder, not the machine. Warp/lane geometry, the memory map,
// the scratchpad + DMA interface, the barrier context and the termination
// condition are open questions (golden/CONTRACT.md §2). Nothing here may be
// read as an answer to them, and nothing here is derived from ../src.
//
// The CPU type is provisional: the ISA is the RISC-V standard plus our own
// custom-extension documents, and those documents do not exist yet.

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac"
    hartId: 0
