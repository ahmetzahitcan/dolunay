<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The model itself: pure C#, no reference to Renode.
    It will hold the step of one warp over the world the warps share,
    the interpreter and the decoder, the policies, the conflict check and the
    observation writer. If a signature here would mention a Renode type, it
    belongs in Dolunay.Renode instead; if a branch encodes an architectural
    rule, it belongs here.
  -->

  <PropertyGroup>
    <RootNamespace>Dolunay.Model</RootNamespace>
  </PropertyGroup>

</Project>
