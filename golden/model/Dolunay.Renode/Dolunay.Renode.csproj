<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Renode glue (golden/DECISIONS.md D8, D11): CPU.Dolunay, the opcode
    overrides, the lane coordinator, the scratchpad bus device. Architectural
    rules belong in Dolunay.Model, not here.

    Renode's assemblies are not published on NuGet, so the build needs the
    unpacked Renode tree:

        RENODE_BIN=/path/to/renode_<version>-portable dotnet build model

    That path is machine-local: it is passed in, never recorded here
    (golden/CONTRACT.md §5). The output, build/plugin/, holds both DLLs to copy
    into that tree.
  -->

  <PropertyGroup>
    <RootNamespace>Antmicro.Renode.Peripherals.CPU</RootNamespace>
    <OutputPath>$(GoldenBuildDir)plugin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Renode's assemblies reference newer System.* versions than the net8.0
         reference pack; benign (golden/SUBSTRATE.md, "Building the plugin"). -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <Target Name="RequireRenodeBin" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(RENODE_BIN)' == ''">
    <Error Text="RENODE_BIN is not set: point it at the unpacked Renode tree containing Infrastructure.dll." />
  </Target>

  <ItemGroup>
    <!-- Private=false: Renode supplies its own assemblies at runtime. -->
    <Reference Include="Infrastructure">
      <HintPath>$(RENODE_BIN)/Infrastructure.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RiscV32's constructor takes ELFSharp.ELF.Endianess. -->
    <Reference Include="ELFSharp">
      <HintPath>$(RENODE_BIN)/ELFSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dolunay.Model/Dolunay.Model.csproj" />
  </ItemGroup>

</Project>
