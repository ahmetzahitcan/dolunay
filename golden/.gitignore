# Generated outputs of the golden model. Paths are relative to this directory.
# Add entries here rather than editing the root .gitignore, which describes what
# the rest of the repository ignores.

# Renode working directories, logs, snapshots and per-run config locks.
build/
*.log
*.lock

# .NET output; every project writes to build/ (see model/Directory.Build.props).
bin/
obj/

# Machine-local launcher (see README.md "Building and running"). Shell
# conventions differ per machine, so this file is not shared.
/run-renode.sh
